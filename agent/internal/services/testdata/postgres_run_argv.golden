run
-d
--rm=false
--name
hookci-svc-01HX-postgres
--label
hookci.run=01HX
--cgroup-parent=hookci.slice
--cpus
1.5
--memory
2147483648b
--network
none
--pids-limit
512
--security-opt
no-new-privileges
--cap-drop
ALL
--cap-add
CHOWN
--cap-add
DAC_OVERRIDE
--cap-add
FOWNER
--cap-add
SETGID
--cap-add
SETUID
--tmpfs
/var/lib/postgresql/data:rw,size=1073741824
-v
/var/lib/hookci/local/runs/01HX/pg:/var/run/postgresql
-e
POSTGRES_HOST_AUTH_METHOD=trust
postgres:16-alpine
