systemd-run
--wait
--pipe
--quiet
--unit
hookci-run-01HXRUN-setup
--slice
hookci.slice
--working-directory
/var/lib/hookci/runs/01HXRUN/src
-p
User=hookci-run
-p
NoNewPrivileges=yes
-p
ProtectSystem=strict
-p
ProtectHome=yes
-p
PrivateTmp=yes
-p
PrivateDevices=yes
-p
ProtectProc=invisible
-p
ProcSubset=pid
-p
ReadWritePaths=/var/lib/hookci/runs/01HXRUN
-p
TemporaryFileSystem=/var/lib/hookci/runs:ro
-p
BindPaths=/var/lib/hookci/runs/01HXRUN
-p
Nice=10
-p
IPAddressDeny=localhost
-p
IPAddressDeny=link-local
-p
IPAddressDeny=multicast
-p
IPAddressDeny=10.0.0.0/8
-p
IPAddressDeny=172.16.0.0/12
-p
IPAddressDeny=192.168.0.0/16
--
/bin/sh
-ec
npm ci
