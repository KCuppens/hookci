systemd-run
--wait
--pipe
--quiet
--unit
zeroci-run-01HXRUN-setup
--slice
zeroci.slice
--working-directory
/var/lib/zeroci/runs/01HXRUN/src
-p
User=zeroci-run
-p
NoNewPrivileges=yes
-p
ProtectSystem=strict
-p
ProtectHome=yes
-p
PrivateTmp=yes
-p
PrivateDevices=yes
-p
ProtectProc=invisible
-p
ProcSubset=pid
-p
ReadWritePaths=/var/lib/zeroci/runs/01HXRUN
-p
TemporaryFileSystem=/var/lib/zeroci/runs:ro
-p
BindPaths=/var/lib/zeroci/runs/01HXRUN
-p
Nice=10
-p
IPAddressDeny=localhost
-p
IPAddressDeny=link-local
-p
IPAddressDeny=multicast
-p
IPAddressDeny=0.0.0.0/8
-p
IPAddressDeny=10.0.0.0/8
-p
IPAddressDeny=100.64.0.0/10
-p
IPAddressDeny=172.16.0.0/12
-p
IPAddressDeny=192.0.0.0/24
-p
IPAddressDeny=192.168.0.0/16
-p
IPAddressDeny=198.18.0.0/15
-p
IPAddressDeny=240.0.0.0/4
-p
IPAddressDeny=::/128
-p
IPAddressDeny=fc00::/7
-p
IPAddressDeny=fec0::/10
--
/bin/sh
-ec
npm ci
