systemd-run
--wait
--pipe
--quiet
--unit
zeroci-run-01HXRUN-lint
--slice
zeroci.slice
--working-directory
/var/lib/zeroci/runs/01HXRUN/src
-p
User=zeroci-run
-p
NoNewPrivileges=yes
-p
ProtectSystem=strict
-p
ProtectHome=yes
-p
PrivateTmp=yes
-p
PrivateDevices=yes
-p
ProtectProc=invisible
-p
ProcSubset=pid
-p
ReadWritePaths=/var/lib/zeroci/runs/01HXRUN
-p
TemporaryFileSystem=/var/lib/zeroci/runs:ro
-p
BindPaths=/var/lib/zeroci/runs/01HXRUN
-p
CPUQuota=150%
-p
MemoryMax=2147483648
-p
TasksMax=512
-p
RuntimeMaxSec=91
-p
IOReadBandwidthMax=/var/lib/zeroci/runs/01HXRUN 52428800
-p
IOWriteBandwidthMax=/var/lib/zeroci/runs/01HXRUN 20971520
-p
Nice=10
-p
IPAddressDeny=any
-p
IPAddressAllow=localhost
-p
NetworkNamespacePath=/run/netns/zc-01HXRUN
-E
PATH=/usr/bin:/bin
-E
CI=true
--
/bin/sh
-ec
npm run lint
