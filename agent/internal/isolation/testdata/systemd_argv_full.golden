systemd-run
--wait
--pipe
--quiet
--unit
hookci-run-01HXRUN-lint
--slice
hookci.slice
--working-directory
/var/lib/hookci/runs/01HXRUN/src
-p
User=hookci-run
-p
NoNewPrivileges=yes
-p
ProtectSystem=strict
-p
ProtectHome=yes
-p
PrivateTmp=yes
-p
PrivateDevices=yes
-p
ProtectProc=invisible
-p
ProcSubset=pid
-p
ReadWritePaths=/var/lib/hookci/runs/01HXRUN
-p
TemporaryFileSystem=/var/lib/hookci/runs:ro
-p
BindPaths=/var/lib/hookci/runs/01HXRUN
-p
CPUQuota=150%
-p
MemoryMax=2147483648
-p
MemorySwapMax=0
-p
TasksMax=512
-p
RuntimeMaxSec=91
-p
Nice=10
-p
IPAddressDeny=any
-p
IPAddressAllow=localhost
-p
NetworkNamespacePath=/run/netns/hci-01HXRUN
-E
PATH=/usr/bin:/bin
-E
CI=true
--
/bin/sh
-ec
npm run lint
