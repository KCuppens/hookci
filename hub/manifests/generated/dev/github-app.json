{
  "name": "zeroci-dev",
  "url": "https://DEV-TUNNEL.example",
  "hook_attributes": { "url": "https://DEV-TUNNEL.example/github/webhook", "active": true },
  "redirect_url": "https://DEV-TUNNEL.example/github/oauth/callback",
  "callback_urls": ["https://DEV-TUNNEL.example/github/oauth/callback", "https://DEV-TUNNEL.example/github/link/callback", "https://DEV-TUNNEL.example/auth/github/callback"],
  "setup_url": "https://DEV-TUNNEL.example/github/oauth/callback",
  "setup_on_update": true,
  "request_oauth_on_install": true,
  "public": true,
  "default_permissions": { "contents": "read", "metadata": "read", "pull_requests": "read", "checks": "write", "members": "read" },
  "default_events": ["pull_request", "push", "check_suite", "check_run", "installation_repositories"]
}
