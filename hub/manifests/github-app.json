{
  "name": "zeroci",
  "url": "https://ci.webuno.io",
  "hook_attributes": { "url": "https://ci.webuno.io/github/webhook", "active": true },
  "redirect_url": "https://ci.webuno.io/github/oauth/callback",
  "callback_urls": ["https://ci.webuno.io/github/oauth/callback", "https://ci.webuno.io/github/link/callback"],
  "setup_url": "https://ci.webuno.io/github/oauth/callback",
  "setup_on_update": true,
  "request_oauth_on_install": true,
  "public": true,
  "default_permissions": { "contents": "read", "metadata": "read", "pull_requests": "read", "checks": "write", "members": "read" },
  "default_events": ["pull_request", "push", "check_suite", "check_run", "installation_repositories"]
}
