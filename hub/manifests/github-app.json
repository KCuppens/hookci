{
  "name": "hookci",
  "url": "https://app.hookci.com",
  "hook_attributes": { "url": "https://app.hookci.com/github/webhook", "active": true },
  "redirect_url": "https://app.hookci.com/github/oauth/callback",
  "callback_urls": ["https://app.hookci.com/github/oauth/callback", "https://app.hookci.com/github/link/callback", "https://app.hookci.com/auth/github/callback"],
  "setup_url": "https://app.hookci.com/github/oauth/callback",
  "setup_on_update": true,
  "request_oauth_on_install": true,
  "public": true,
  "default_permissions": { "contents": "read", "metadata": "read", "pull_requests": "read", "checks": "write", "members": "read" },
  "default_events": ["pull_request", "push", "check_suite", "check_run"]
}
