{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ci.webuno.io/schema/zeroci.schema.json",
  "title": "ZeroCIConfig",
  "description": "ZeroCI repository configuration (.zeroci.yml).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {
      "description": "Configuration format version. Must be 1.",
      "type": "integer",
      "const": 1
    },
    "checks": {
      "description": "Checks that run on pull requests and pushes.",
      "$ref": "#/$defs/Checks"
    },
    "deployments": {
      "description": "Deployments keyed by environment name, for example production.",
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,31}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/Deployment"
      }
    },
    "notify": {
      "description": "Notification targets.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slack": {
          "description": "Slack notifications.",
          "type": "object",
          "additionalProperties": false,
          "required": ["channel"],
          "properties": {
            "channel": {
              "description": "Slack channel name, with or without the leading #.",
              "type": "string",
              "pattern": "^#?[a-z0-9._-]+$"
            },
            "on": {
              "description": "Outcomes that send a notification.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["failure", "success", "deploy", "all"]
              }
            },
            "notify": {
              "description": "How much the run message says, over the channel's /zeroci watch setting: quiet lists job results in the message, normal also replies in its thread per finished job. verbose means normal.",
              "type": "string",
              "enum": ["quiet", "normal", "verbose"]
            },
            "alert": {
              "description": "Where the failure alert goes, over the channel's /zeroci watch setting: the message thread, or a DM to the commit author.",
              "type": "string",
              "enum": ["channel", "dm"]
            }
          }
        }
      }
    },
    "redact": {
      "description": "Extra RE2 patterns whose matches are masked in logs.",
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string"
      }
    },
    "logs": {
      "description": "Where job logs go: hub uploads each job log to the hub for signed View log links; local keeps logs on the agent only.",
      "type": "string",
      "enum": ["hub", "local"],
      "default": "hub"
    }
  },
  "$defs": {
    "Checks": {
      "description": "Check configuration: triggers, trust policy, limits, setup, jobs, services and egress.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on": {
          "description": "Events that start a check run.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pull_request": {
              "description": "Run checks on pull requests.",
              "type": "boolean",
              "default": true
            },
            "push": {
              "description": "Run checks on pushes.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "branches": {
                  "description": "Branches whose pushes start a check run.",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": ["main"]
                }
              }
            }
          }
        },
        "trust": {
          "description": "Whose pull requests run automatically: repository collaborators, only after approval, or everyone.",
          "type": "string",
          "enum": ["collaborators", "approve", "all"],
          "default": "collaborators"
        },
        "forks": {
          "description": "Fork pull requests: gated behind approval, or never run.",
          "type": "string",
          "enum": ["gated", "never"],
          "default": "gated"
        },
        "limits": {
          "description": "Default resource limits for every job.",
          "$ref": "#/$defs/Limits"
        },
        "setup": {
          "description": "Steps that run once before the jobs.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/SetupStep"
          }
        },
        "jobs": {
          "description": "Check jobs keyed by name.",
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Job"
          }
        },
        "services": {
          "description": "Service containers available to the jobs.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "postgres": {
              "description": "A PostgreSQL server reachable over a unix socket.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "image": {
                  "description": "Container image.",
                  "type": "string",
                  "default": "postgres:16-alpine"
                },
                "tmpfs": {
                  "description": "Keep the data directory on tmpfs.",
                  "type": "boolean",
                  "default": true
                }
              }
            }
          }
        },
        "egress": {
          "description": "Extra exact host names the jobs may reach through the egress proxy on port 443.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          }
        }
      }
    },
    "Limits": {
      "description": "Resource limits for a job.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cpus": {
          "description": "CPU quota in cores.",
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 64,
          "default": 2
        },
        "memory": {
          "description": "Memory limit with a K, M or G suffix, for example 4G.",
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?[KMG]$",
          "default": "4G"
        },
        "timeout": {
          "description": "Wall clock timeout with an s, m or h suffix, for example 10m.",
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$",
          "default": "10m"
        },
        "tasks": {
          "description": "Maximum number of processes and threads.",
          "type": "integer",
          "minimum": 16,
          "maximum": 65536,
          "default": 512
        }
      }
    },
    "SetupStep": {
      "description": "A setup command with an optional cache.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": {
          "description": "Shell command.",
          "type": "string",
          "minLength": 1
        },
        "cache": {
          "description": "Directories restored before and saved after the step.",
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "paths"],
          "properties": {
            "key": {
              "description": "Files whose content hash forms the cache key.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "paths": {
              "description": "Directories to cache, relative to the repository root.",
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "Job": {
      "description": "A check job.",
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": {
          "description": "Shell command.",
          "type": "string"
        },
        "annotate": {
          "description": "Parse the job output with this format and report annotations.",
          "type": "string",
          "enum": ["eslint", "tsc"]
        },
        "needs": {
          "description": "Jobs that must succeed before this one starts.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "description": "Resource limits that override the checks limits.",
          "$ref": "#/$defs/Limits"
        },
        "timeout": {
          "description": "Wall clock timeout with an s, m or h suffix. Overrides limits.timeout.",
          "type": "string",
          "pattern": "^[0-9]+(s|m|h)$"
        }
      }
    },
    "Deployment": {
      "description": "A deployment to one environment. The agent checks the strategy-dependent rules (required sections, {port}, absolute paths, durations, needs) after schema validation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["on", "strategy"],
      "properties": {
        "on": {
          "description": "Event that starts the deployment.",
          "type": "object",
          "additionalProperties": false,
          "required": ["push"],
          "properties": {
            "push": {
              "description": "Branch whose pushes deploy.",
              "type": "string",
              "minLength": 1
            },
            "after": {
              "description": "What must pass before the deployment starts.",
              "type": "string",
              "enum": ["checks"],
              "default": "checks"
            }
          }
        },
        "strategy": {
          "description": "How the new version replaces the old one. compose-bluegreen starts the other color and switches the route, compose-inplace recreates the service, script runs the run command.",
          "type": "string",
          "enum": ["compose-bluegreen", "compose-inplace", "script"]
        },
        "compose": {
          "description": "Docker Compose project to deploy. Required for the compose strategies.",
          "type": "object",
          "additionalProperties": false,
          "required": ["project", "service"],
          "properties": {
            "project": {
              "description": "Compose project name.",
              "type": "string",
              "minLength": 1
            },
            "file": {
              "description": "Compose file, relative to the repository root.",
              "type": "string",
              "minLength": 1,
              "default": "docker-compose.yml"
            },
            "service": {
              "description": "Service that serves the application.",
              "type": "string",
              "minLength": 1
            },
            "shared_network": {
              "description": "External Docker network the service joins, for example the reverse proxy network.",
              "type": "string",
              "minLength": 1
            },
            "marker": {
              "description": "Absolute path of the file that records the active color.",
              "type": "string"
            }
          }
        },
        "migrate": {
          "description": "Database migration run before the switch.",
          "type": "object",
          "additionalProperties": false,
          "required": ["run"],
          "properties": {
            "run": {
              "description": "Migration command, run in the new image.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "route": {
          "description": "Reverse proxy route switched between colors. Required for compose-bluegreen.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "file"],
          "properties": {
            "kind": {
              "description": "Reverse proxy.",
              "type": "string",
              "enum": ["caddy"]
            },
            "file": {
              "description": "Absolute path of the route file zeroci writes.",
              "type": "string"
            },
            "reload": {
              "description": "Command that reloads the proxy after the route file changes.",
              "type": "string",
              "minLength": 1,
              "default": "caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile"
            },
            "upstream_host": {
              "description": "Host the proxy reaches the service on.",
              "type": "string",
              "minLength": 1,
              "default": "127.0.0.1"
            }
          }
        },
        "health": {
          "description": "Health check of the new version. Required for the compose strategies.",
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": {
              "description": "Local URL to probe. The compose strategies fill in {port}, which the URL must contain.",
              "type": "string"
            },
            "expect": {
              "description": "Expected HTTP status code.",
              "type": "integer",
              "default": 200
            },
            "retries": {
              "description": "Probes before the deployment counts as unhealthy.",
              "type": "integer",
              "minimum": 1,
              "maximum": 600,
              "default": 40
            },
            "interval": {
              "description": "Time between probes, as a Go duration such as 2s or 500ms.",
              "type": "string",
              "default": "2s"
            }
          }
        },
        "verify": {
          "description": "Watch window after the switch, during which a failed probe rolls back.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "window": {
              "description": "How long to watch, as a Go duration such as 60s.",
              "type": "string",
              "default": "60s"
            },
            "interval": {
              "description": "Time between probes, as a Go duration. At most window.",
              "type": "string",
              "default": "5s"
            }
          }
        },
        "env_file": {
          "description": "Absolute path of the environment file on the host.",
          "type": "string"
        },
        "retain": {
          "description": "What to keep for rollback.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "images": {
              "description": "Number of images to keep, counting the running one.",
              "type": "integer",
              "minimum": 2,
              "default": 5
            }
          }
        },
        "paths": {
          "description": "Globs relative to the repository root. When set, a push deploys only if it changes a matching file.",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "needs": {
          "description": "Environments whose deployment of the same commit must succeed first.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$"
          }
        },
        "run": {
          "description": "Deploy command. Required for strategy: script. Each stdout line \"::zeroci step <name>\" (name: lowercase letters, digits, \"_\", \".\" and \"-\", up to 40 characters) reports a progress step. A resumed deploy re-runs the command from the start.",
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "description": "Command that restores the previous version. Optional, strategy: script only. Runs when run fails, with ZEROCI_FAILED_STEP set to the last step run reported.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "AgentConfig": {
      "title": "AgentConfig",
      "description": "Settings of the agent host (agent.json), not part of .zeroci.yml.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gc": {
          "description": "Disk cleanup limits.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "build_cache_max_bytes": {
              "description": "Docker build cache size above which the agent prunes it.",
              "type": "integer",
              "minimum": 0,
              "default": 10737418240
            },
            "min_free_bytes": {
              "description": "Free disk space below which the agent prunes images and build cache.",
              "type": "integer",
              "minimum": 0,
              "default": 5368709120
            }
          }
        }
      }
    },
    "protocol": {
      "description": "Agent to hub WebSocket protocol. Every frame is a JSON object with v and type. Frames sent through an outbox also carry seq, which the receiver acknowledges with ack; hello, ack and welcome are never sequenced.",
      "$defs": {
        "Envelope": {
          "description": "Fields shared by every frame.",
          "type": "object",
          "required": ["v", "type"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string"
            }
          }
        },
        "Hello": {
          "description": "First frame the agent sends after connecting.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "protocol_version", "agent_version"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "hello"
            },
            "protocol_version": {
              "description": "Protocol version the agent speaks.",
              "type": "integer",
              "const": 1
            },
            "agent_version": {
              "description": "Agent build version.",
              "type": "string"
            },
            "agent_id": {
              "description": "Agent identifier, when already registered.",
              "type": "string"
            },
            "inbound_hwm": {
              "description": "Highest hub seq the agent has processed. The hub replays outbox frames above it. Absent means 0.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "Trigger": {
          "description": "Hub to agent: start a run for a commit.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "hub_seq", "trigger_id", "repo", "sha", "ref", "event", "attempt", "trust"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "trigger"
            },
            "seq": {
              "description": "Hub outbox sequence number, acknowledged by the agent with ack.",
              "type": "integer",
              "minimum": 1
            },
            "hub_seq": {
              "description": "Hub sequence number, acknowledged by the agent.",
              "type": "integer"
            },
            "trigger_id": {
              "description": "Hub trigger identifier.",
              "type": "string"
            },
            "repo": {
              "description": "Repository as owner/name.",
              "type": "string"
            },
            "sha": {
              "description": "Commit to check out.",
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "ref": {
              "description": "Git ref that triggered the run.",
              "type": "string"
            },
            "event": {
              "description": "GitHub event behind the trigger.",
              "type": "string",
              "enum": ["pull_request", "push", "retry"]
            },
            "env": {
              "description": "Deployment environment, for deploy triggers.",
              "type": "string",
              "minLength": 1
            },
            "pr": {
              "description": "Pull request details for pull_request events.",
              "type": "object",
              "additionalProperties": false,
              "required": ["number", "head_ref", "head_repo_full_name", "fork"],
              "properties": {
                "number": {
                  "description": "Pull request number.",
                  "type": "integer"
                },
                "head_ref": {
                  "description": "Head branch name.",
                  "type": "string"
                },
                "head_repo_full_name": {
                  "description": "Head repository as owner/name.",
                  "type": "string"
                },
                "fork": {
                  "description": "The head repository is a fork.",
                  "type": "boolean"
                }
              }
            },
            "base_sha": {
              "description": "Base commit of the pull request.",
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "attempt": {
              "description": "Attempt number, 1 for the first run.",
              "type": "integer",
              "minimum": 1
            },
            "trust": {
              "description": "Trust domain the run executes in.",
              "type": "string",
              "enum": ["trusted", "untrusted"]
            }
          }
        },
        "Accepted": {
          "description": "Agent accepted a trigger and created a run.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "trigger_id", "run_id"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "accepted"
            },
            "seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub with ack.",
              "type": "integer",
              "minimum": 1
            },
            "trigger_id": {
              "description": "Hub trigger identifier.",
              "type": "string"
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            }
          }
        },
        "Rejected": {
          "description": "Agent refused a trigger.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "trigger_id", "reason"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "rejected"
            },
            "seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub with ack.",
              "type": "integer",
              "minimum": 1
            },
            "trigger_id": {
              "description": "Hub trigger identifier.",
              "type": "string"
            },
            "reason": {
              "description": "Why the trigger was refused.",
              "type": "string"
            }
          }
        },
        "JobPlanned": {
          "description": "Jobs the agent planned for a run.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "run_id", "jobs"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "job_planned"
            },
            "seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub with ack.",
              "type": "integer",
              "minimum": 1
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            },
            "jobs": {
              "description": "Planned jobs.",
              "type": "array",
              "items": {
                "description": "A planned job.",
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "needs"],
                "properties": {
                  "name": {
                    "description": "Job name.",
                    "type": "string"
                  },
                  "needs": {
                    "description": "Jobs this job waits for.",
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "env": {
              "description": "Deployment environment, for deploy runs.",
              "type": "string"
            },
            "slack": {
              "description": "The trusted config's notify.slack block, which takes precedence over the repo's Slack watches.",
              "type": "object",
              "additionalProperties": false,
              "required": ["channel"],
              "properties": {
                "channel": {
                  "description": "Slack channel name, with or without the leading #.",
                  "type": "string"
                },
                "notify": {
                  "description": "quiet, normal or verbose; verbose means normal.",
                  "type": "string",
                  "enum": ["quiet", "normal", "verbose"]
                },
                "alert": {
                  "description": "channel or dm.",
                  "type": "string",
                  "enum": ["channel", "dm"]
                }
              }
            }
          }
        },
        "Event": {
          "description": "Run or job state change.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "agent_seq", "run_id", "state"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "event"
            },
            "seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub with ack.",
              "type": "integer",
              "minimum": 1
            },
            "agent_seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub.",
              "type": "integer"
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            },
            "job": {
              "description": "Job name. Absent for run events.",
              "type": "string"
            },
            "state": {
              "description": "New run or job state.",
              "type": "string",
              "enum": ["queued", "running", "success", "failed", "cancelled", "skipped", "superseded", "interrupted", "verifying", "rolling_back"]
            },
            "step": {
              "description": "Current step name.",
              "type": "string"
            },
            "step_index": {
              "description": "Current step index, starting at 0.",
              "type": "integer"
            },
            "steps_total": {
              "description": "Number of steps.",
              "type": "integer"
            },
            "duration_ms": {
              "description": "Duration in milliseconds, for finished jobs.",
              "type": "integer"
            },
            "tail": {
              "description": "Last log lines, for failed jobs.",
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string"
              }
            },
            "reason": {
              "description": "Why the state changed.",
              "type": "string"
            },
            "logs": {
              "description": "local when the repo config keeps job logs on the agent; set on finished jobs.",
              "type": "string",
              "enum": ["local"]
            }
          }
        },
        "Annotations": {
          "description": "File annotations parsed from a job's output.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "agent_seq", "run_id", "job", "items"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "annotations"
            },
            "seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub with ack.",
              "type": "integer",
              "minimum": 1
            },
            "agent_seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub.",
              "type": "integer"
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            },
            "job": {
              "description": "Job name.",
              "type": "string"
            },
            "items": {
              "description": "Annotations.",
              "type": "array",
              "maxItems": 50,
              "items": {
                "description": "One annotation.",
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "line", "level", "message"],
                "properties": {
                  "path": {
                    "description": "File path relative to the repository root.",
                    "type": "string"
                  },
                  "line": {
                    "description": "Line number, starting at 1.",
                    "type": "integer"
                  },
                  "column": {
                    "description": "Column number, starting at 1.",
                    "type": "integer"
                  },
                  "level": {
                    "description": "Severity.",
                    "type": "string",
                    "enum": ["notice", "warning", "failure"]
                  },
                  "message": {
                    "description": "Annotation text.",
                    "type": "string"
                  },
                  "title": {
                    "description": "Short title.",
                    "type": "string"
                  }
                }
              }
            },
            "total": {
              "description": "Number of annotations found, including those not sent in items.",
              "type": "integer"
            }
          }
        },
        "TokenRequest": {
          "description": "Agent asks the hub for a short-lived GitHub token.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "run_id", "purpose"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "token_request"
            },
            "seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub with ack.",
              "type": "integer",
              "minimum": 1
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            },
            "purpose": {
              "description": "What the token is used for.",
              "type": "string",
              "enum": ["fetch"]
            }
          }
        },
        "Token": {
          "description": "Hub answers a token request.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "run_id", "token", "exp"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "token"
            },
            "seq": {
              "description": "Hub outbox sequence number, acknowledged by the agent with ack.",
              "type": "integer",
              "minimum": 1
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            },
            "token": {
              "description": "GitHub installation token.",
              "type": "string"
            },
            "exp": {
              "description": "Expiry as unix seconds.",
              "type": "integer"
            }
          }
        },
        "LogSubscribe": {
          "description": "Hub asks the agent to stream a log.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "run_id"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "log_subscribe"
            },
            "seq": {
              "description": "Hub outbox sequence number, acknowledged by the agent with ack.",
              "type": "integer",
              "minimum": 1
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            },
            "job": {
              "description": "Job name. Absent for the whole run.",
              "type": "string"
            },
            "from_offset": {
              "description": "Byte offset to start from.",
              "type": "integer",
              "default": 0
            }
          }
        },
        "Log": {
          "description": "A chunk of job log.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "run_id", "job", "offset", "bytes"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "log"
            },
            "seq": {
              "description": "Agent outbox sequence number, acknowledged by the hub with ack.",
              "type": "integer",
              "minimum": 1
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            },
            "job": {
              "description": "Job name.",
              "type": "string"
            },
            "offset": {
              "description": "Byte offset of the chunk in the log.",
              "type": "integer"
            },
            "bytes": {
              "description": "Log bytes, base64 encoded.",
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        },
        "Ack": {
          "description": "Acknowledges every sequence number up to and including upto.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "upto"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "ack"
            },
            "upto": {
              "description": "Highest acknowledged sequence number.",
              "type": "integer"
            }
          }
        },
        "Welcome": {
          "description": "Hub accepts the agent's hello.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "hub_version", "protocol_min", "protocol_max", "agent_id", "installation_id"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "welcome"
            },
            "hub_version": {
              "description": "Hub release version.",
              "type": "string"
            },
            "protocol_min": {
              "description": "Oldest protocol version the hub accepts.",
              "type": "integer"
            },
            "protocol_max": {
              "description": "Newest protocol version the hub accepts.",
              "type": "integer"
            },
            "agent_id": {
              "description": "Agent identifier assigned by the hub.",
              "type": "string"
            },
            "installation_id": {
              "description": "GitHub App installation the agent belongs to.",
              "type": "integer"
            },
            "latest_agent_version": {
              "description": "Newest released agent version; the agent logs an upgrade hint when it runs an older one.",
              "type": "string"
            },
            "min_agent_version": {
              "description": "Oldest agent version the hub serves; an older agent stops with agent_too_old.",
              "type": "string"
            }
          }
        },
        "Interrupt": {
          "description": "Hub tells the agent to stop a run, or a trigger that has no run yet. Carries exactly one of run_id or trigger_id.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "reason"],
          "oneOf": [{ "required": ["run_id"] }, { "required": ["trigger_id"] }],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "interrupt"
            },
            "seq": {
              "description": "Hub outbox sequence number, acknowledged by the agent with ack.",
              "type": "integer",
              "minimum": 1
            },
            "run_id": {
              "description": "Agent run identifier.",
              "type": "string"
            },
            "trigger_id": {
              "description": "Hub trigger identifier.",
              "type": "string"
            },
            "reason": {
              "description": "Why the run or trigger is stopped.",
              "type": "string",
              "enum": ["superseded", "revoked", "uninstalled", "repair"]
            }
          }
        },
        "Error": {
          "title": "ProtocolErrorFrame",
          "description": "Hub reports a protocol or connection error.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "type", "code", "message"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "type": {
              "description": "Message type.",
              "type": "string",
              "const": "error"
            },
            "seq": {
              "description": "Hub outbox sequence number, acknowledged by the agent with ack. Absent on errors sent outside the outbox.",
              "type": "integer",
              "minimum": 1
            },
            "code": {
              "description": "Machine-readable error code.",
              "type": "string",
              "enum": ["protocol_unsupported", "auth_failed", "revoked", "rate_limited", "bad_frame", "internal"]
            },
            "message": {
              "description": "Human-readable explanation.",
              "type": "string"
            },
            "upgrade_hint": {
              "description": "How to upgrade the agent, sent with protocol_unsupported.",
              "type": "string"
            }
          }
        },
        "RenderRequest": {
          "description": "Body of POST /v1/render: an agent asks the hub to render a deploy badge for a dry-run preview. Not a WebSocket frame.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "kind", "repo", "env", "sha", "state"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "kind": {
              "description": "What to render.",
              "type": "string",
              "const": "deploy_badge"
            },
            "repo": {
              "description": "Repository as owner/name.",
              "type": "string"
            },
            "env": {
              "description": "Deployment environment.",
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,31}$"
            },
            "sha": {
              "description": "Commit being deployed.",
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "state": {
              "description": "Deploy state to render.",
              "type": "string",
              "enum": ["queued", "running", "rolling_back", "succeeded", "failed"]
            },
            "step": {
              "description": "Current step name.",
              "type": "string"
            },
            "step_index": {
              "description": "Current step index, starting at 0.",
              "type": "integer",
              "minimum": 0
            },
            "steps_total": {
              "description": "Number of steps.",
              "type": "integer",
              "minimum": 1
            },
            "duration_ms": {
              "description": "Elapsed deploy time in milliseconds.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "RenderResponse": {
          "description": "Answer to POST /v1/render: the Slack badge the hub would post.",
          "type": "object",
          "additionalProperties": false,
          "required": ["v", "text", "blocks"],
          "properties": {
            "v": {
              "description": "Protocol version.",
              "type": "integer",
              "const": 1
            },
            "text": {
              "description": "Badge text, the Slack message fallback.",
              "type": "string"
            },
            "blocks": {
              "description": "Slack Block Kit blocks.",
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "Frame": {
          "description": "Any protocol frame, selected by its type.",
          "oneOf": [
            { "$ref": "#/$defs/protocol/$defs/Hello" },
            { "$ref": "#/$defs/protocol/$defs/Trigger" },
            { "$ref": "#/$defs/protocol/$defs/Accepted" },
            { "$ref": "#/$defs/protocol/$defs/Rejected" },
            { "$ref": "#/$defs/protocol/$defs/JobPlanned" },
            { "$ref": "#/$defs/protocol/$defs/Event" },
            { "$ref": "#/$defs/protocol/$defs/Annotations" },
            { "$ref": "#/$defs/protocol/$defs/TokenRequest" },
            { "$ref": "#/$defs/protocol/$defs/Token" },
            { "$ref": "#/$defs/protocol/$defs/LogSubscribe" },
            { "$ref": "#/$defs/protocol/$defs/Log" },
            { "$ref": "#/$defs/protocol/$defs/Ack" },
            { "$ref": "#/$defs/protocol/$defs/Welcome" },
            { "$ref": "#/$defs/protocol/$defs/Interrupt" },
            { "$ref": "#/$defs/protocol/$defs/Error" }
          ]
        }
      }
    }
  }
}
